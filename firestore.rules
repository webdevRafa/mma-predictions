rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /fighters/{fighterId} {
      allow read: if true;
      allow write: if false;
    }

    match /prizepickOdds/{snapshotId} {
      allow read: if true;
      allow write: if false;

      match /lines/{lineId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /logs/{logId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
