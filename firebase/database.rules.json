{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      "v1": {
        "rooms": {
          "$roomId": {
            "messages": {
              ".read": true,
              ".write": false,
              ".indexOn": ["createdAt"]
            },
            "presence": {
              ".read": false,
              ".write": false
            },
            "typing": { ".read": false, ".write": false }
          }
        },
        "rateLimits": { ".read": false, ".write": false }
      }
    }
  }
}
