{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      "v1": {
        "rooms": {
          "$roomId": {
            "messages": {
              ".read": true,
              ".write": false,
              ".indexOn": ["createdAt"]
            },
            "presence": {
              ".read": true,
              "$uid": {
                ".write": "$uid === auth.uid",
                ".validate": "newData.hasChildren(['connected', 'lastSeen'])",
                "connected": {
                  ".validate": "newData.isBoolean()"
                },
                "lastSeen": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "typing": { ".read": false, ".write": false }
          }
        },
        "rateLimits": { ".read": false, ".write": false }
      }
    }
  }
}
