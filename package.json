{
  "name": "fightlobby",
  "version": "0.1.0",
  "private": true,
  "description": "UFC predictions, live matchup chat, and fight-night discussion.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @fightlobby/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:rules": "firebase emulators:exec --only firestore,database,storage --project fightlobby-local \"cross-env RULES_TEST=1 vitest run tests/rules tests/integration\"",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "staging:simulate": "firebase emulators:exec --only firestore,database,storage --project fightlobby-local \"cross-env STAGING_SIMULATION=1 tsx scripts/run-staging-simulation.ts\"",
    "launch:preflight": "tsx scripts/production-preflight.ts",
    "launch:verify": "tsx scripts/verify-production.ts",
    "audit:production:predictions": "tsx scripts/audit-production-predictions.ts",
    "repair:production:grading": "tsx scripts/repair-production-grading.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "migrate:remove-confidence": "tsx scripts/migrate-remove-confidence.ts",
    "import:production:event": "tsx scripts/import-production-event.ts",
    "add:production:event": "tsx scripts/add-production-event.ts",
    "refresh:production:event": "tsx scripts/refresh-production-event.ts",
    "import:production:articles": "tsx scripts/import-production-articles.ts",
    "validate:fixtures": "tsx scripts/validate-fixture.ts fixtures",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start --config firebase.json"
  },
  "devDependencies": {
    "@fightlobby/domain": "workspace:*",
    "@firebase/rules-unit-testing": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cross-env": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "firebase-tools": "latest",
    "firebase-admin": "latest",
    "firebase": "latest",
    "globals": "latest",
    "next": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "^6.0.2",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
