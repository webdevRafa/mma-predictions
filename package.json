{
  "name": "fightlobby",
  "version": "0.1.0",
  "private": true,
  "description": "FightLobby — every fight has a lobby.",
  "packageManager": "pnpm@10.17.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "pnpm --filter @fightlobby/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "validate:fixtures": "tsx scripts/validate-fixture.ts fixtures",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start --config firebase.json"
  },
  "devDependencies": {
    "@fightlobby/domain": "workspace:*",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "firebase-tools": "latest",
    "globals": "latest",
    "next": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "^6.0.2",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
